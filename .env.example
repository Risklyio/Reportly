# Supabase (required on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# For npm run supabase:setup (and optional /api/setup on Vercel)
# Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: one-time Vercel setup via browser
# SETUP_SECRET=change-me-to-a-long-random-string

# AI — Generate corrective actions
# Recommended free tier: Groq
AI_PROVIDER=groq
GROQ_API_KEY=

# Or: Google Gemini (aistudio.google.com/apikey)
# AI_PROVIDER=google
# GOOGLE_GENERATIVE_AI_API_KEY=
# AI_MODEL=gemini-2.0-flash-lite

# Or: OpenAI (paid) — AI_PROVIDER=openai, OPENAI_API_KEY=sk-...
