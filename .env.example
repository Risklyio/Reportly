# Supabase (required on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# For npm run supabase:setup (and optional /api/setup on Vercel)
# Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: one-time Vercel setup via browser
# SETUP_SECRET=change-me-to-a-long-random-string

# AI — Generate corrective actions from assessor notes (Vercel AI SDK + OpenAI)
OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
